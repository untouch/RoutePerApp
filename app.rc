// Datei-Eigenschaften und Symbol von routeperapp.exe.
// Die Fassung steht auch in gui.cpp (kAppVersion) - beide beim Veröffentlichen anpassen.
#include <winver.h>
#include "src/resource.hpp"

IDI_APP ICON "app.ico"

// Sprachtabellen als eingebettete Datei (lang\en.json), siehe src/lang.cpp.
IDR_LANG_EN RCDATA "lang\en.json"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "RoutePerApp"
            VALUE "FileDescription",  "RoutePerApp - network route per program"
            VALUE "FileVersion",      "1.0"
            VALUE "InternalName",     "routeperapp"
            VALUE "LegalCopyright",   "Copyright (C) 2026 Keven Hall"
            VALUE "OriginalFilename", "routeperapp.exe"
            VALUE "ProductName",      "RoutePerApp"
            VALUE "ProductVersion",   "1.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
